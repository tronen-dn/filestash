# Local-source build (includes uncommitted changes in this worktree).
# Build context must be the worktree root: docker build -f docker/Dockerfile.local -t filestash-entra .
FROM golang:1.26-trixie AS build
WORKDIR /home/filestash/
COPY . .
RUN apt-get update && apt-get install -y curl make \
      libjpeg-dev libtiff-dev libpng-dev libwebp-dev libraw-dev \
      libheif-dev libgif-dev libvips-dev libbrotli-dev && \
    make init && \
    printf 'package common\n\nfunc init() {\n\tBUILD_REF = "localdev-entra"\n\tBUILD_DATE = "20260628"\n}\n' > server/common/constants_generated.go && \
    make build && \
    mkdir -p ./dist/data/state/config/ && \
    cp config/config.json ./dist/data/state/config/config.json

FROM debian:stable-slim
WORKDIR /app/
COPY --from=build /home/filestash/dist/ .
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl ffmpeg libjpeg-dev libtiff-dev libpng-dev libwebp-dev \
      libraw-dev libheif-dev libgif-dev && \
    rm -rf /var/lib/apt/lists/* /tmp/*
EXPOSE 8334
CMD ["/app/filestash"]
